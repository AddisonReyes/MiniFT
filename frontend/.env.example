# Local web development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Android emulator tip:
# Use your deployed HTTPS backend for cookie auth, for example:
# NEXT_PUBLIC_API_BASE_URL=https://minift-backend.up.railway.app/api
#
# If you point the emulator at a backend running on your host machine, Android
# typically reaches it through http://10.0.2.2:<port>/api instead of localhost.

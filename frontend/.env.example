# Local web development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
CAPACITOR_ANDROID_STUDIO_PATH=/snap/bin/android-studio
ANDROID_SDK_ROOT=/home/<your-user>/Android/Sdk
ANDROID_EMULATOR_NAME=Small_Phone

# Optional Android emulator tuning
# ADB_VENDOR_KEYS defaults to the standard private key file used by adb.
# ANDROID_EMULATOR_GPU_MODE defaults to swiftshader_indirect for better stability
# on Linux when the emulator crashes with host GPU rendering.
# ANDROID_REVERSE_PORTS defaults to 8000 and configures adb reverse so the
# Android emulator can reach your local backend through http://localhost:8000.
# ANDROID_EMULATOR_FLAGS can be used for one-off flags such as -wipe-data.
# ANDROID_JAVA_HOME defaults to /snap/android-studio/current/jbr when available.
# ANDROID_LAUNCH_ACTIVITY defaults to app.minift.net/app.minift.net.MainActivity.
# ANDROID_DEVICE_ID is optional if you want to target a specific emulator/device.
# ADB_VENDOR_KEYS=/home/<your-user>/.android/adbkey
# ANDROID_EMULATOR_GPU_MODE=swiftshader_indirect
# ANDROID_REVERSE_PORTS=8000
# ANDROID_JAVA_HOME=/snap/android-studio/current/jbr
# ANDROID_DEVICE_ID=emulator-5554
# ANDROID_LAUNCH_ACTIVITY=app.minift.net/app.minift.net.MainActivity
# ANDROID_EMULATOR_FLAGS=-wipe-data

# Android emulator tip:
# Use your deployed HTTPS backend for cookie auth, for example:
# NEXT_PUBLIC_API_BASE_URL=https://minift-backend.up.railway.app/api
# When you do that, make sure the backend allows the localhost WebView origins in
# CORS_ALLOWED_ORIGINS. This repo uses http://localhost on Android, but allowing
# https://localhost too makes stale native builds more forgiving.
#
# MiniFT's terminal workflow uses adb reverse, so the emulator can keep using
# http://localhost:8000/api and still reach the backend running on your machine.
